{
  "$schema": "./node_modules/knip/schema.json",
  "ignore": [".agents/**", "examples/**"],
  "workspaces": {
    ".": {
      "ignoreBinaries": ["adb", "rustfmt", "where.exe"]
    },
    "apps/desktop": {
      "entry": ["index.html", "demo/main.tsx", "e2e/**/*.spec.ts"],
      "project": ["src/**/*.{ts,tsx,css}", "e2e/**/*.ts", "demo/**/*.{ts,tsx}", "*.ts"],
      "paths": { "@/*": ["./src/*"] }
    },
    "packages/core": {},
    "packages/ui": {}
  }
}

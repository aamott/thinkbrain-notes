{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Thinkbrain Notes",
  "version": "0.0.0",
  "identifier": "com.thinkbrain.notes",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Thinkbrain Notes",
        "width": 1100,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}

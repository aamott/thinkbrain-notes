{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Thinkbrain Notes",
  "version": "0.1.0",
  "identifier": "com.thinkbrain.notes",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Thinkbrain Notes",
        "width": 1100,
        "height": 720
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCQjAxMkRCN0ZCQUVEOEQKUldTTjdicC8yeEt3K3hlLzIwTDNTaUdzSUxFYjVNcnhnZ3poN1BQWjB6ZEVFbG1WcDhQRzVsaTkK",
      "endpoints": [
        "https://github.com/aamott/thinkbrain-notes/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["presets/themes/*.tbtheme.json"]
  }
}

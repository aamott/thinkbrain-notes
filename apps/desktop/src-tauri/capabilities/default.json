{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the scaffolded desktop window.",
  "windows": [
    "main",
    "workspace-*"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-write-text-file",
    "fs:allow-read-text-file",
    "updater:default",
    "process:allow-restart"
  ]
}

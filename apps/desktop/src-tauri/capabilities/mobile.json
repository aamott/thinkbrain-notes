{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "mobile",
  "description": "Default permissions for mobile windows.",
  "platforms": [
    "android",
    "iOS"
  ],
  "windows": [
    "main",
    "workspace-*"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-write-text-file",
    "fs:allow-read-text-file",
    "process:allow-restart"
  ]
}
